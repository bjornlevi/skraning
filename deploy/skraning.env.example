# Copy to /etc/default/skraning (chmod 600) and fill in.
PREFIX=/skraning
BASE_URL=https://bjornlevi.is/skraning
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
DATABASE=/srv/skraning/data/skraning.db
UPLOAD_DIR=/srv/skraning/data/uploads
TIMEZONE=Atlantic/Reykjavik
SITE_NAME=Skráning
# Shared association password required to create events (required)
CREATE_PASSWORD=change-me

MAIL_BACKEND=smtp
MAIL_FROM=no-reply@bjornlevi.is
MAIL_FROM_NAME=Skráning
# Local Postfix:
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_STARTTLS=
SMTP_USER=
SMTP_PASSWORD=
# ...or authenticated submission to a mail host:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_STARTTLS=1
# SMTP_USER=no-reply@bjornlevi.is
# SMTP_PASSWORD=...
